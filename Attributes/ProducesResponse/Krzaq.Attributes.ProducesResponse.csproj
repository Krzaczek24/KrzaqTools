<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackageProjectUrl>https://github.com/Krzaczek24?tab=packages</PackageProjectUrl>
        <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
        <RepositoryUrl>https://github.com/Krzaczek24/KrzaqTools</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageId>Krzaq.Attributes.ProducesResponse</PackageId>
        <Version>1.0.0</Version>
        <Authors>Tomasz 'Krzaczek' Drewek</Authors>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.AspNetCore.Mvc.Core" Version="2.3.12" />
      <PackageReference Include="Microsoft.Extensions.DependencyModel" Version="10.0.11" />
    </ItemGroup>

</Project>
